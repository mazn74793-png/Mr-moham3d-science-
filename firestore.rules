rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL HARDENED HELPERS
    // ==========================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGradeId(g) {
      return g is string && g.size() > 0 && g.size() <= 64 && g.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPrimaryAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'mizoo2y2@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerifiedUser() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/adminConfig/settings) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/adminConfig/settings).data.adminEmails
      );
    }

    // ==========================================
    // ENTITY VALIDATION HELPERS
    // ==========================================
    function isValidSiteConfig(data) {
      return data.keys().hasAll(['teacherName', 'teacherTitle', 'profileImageUrl', 'updatedAt']) &&
        data.keys().hasOnly([
          'teacherName', 'teacherTitle', 'tagline', 'heroDescription', 'heroBadge',
          'profileImageUrl', 'calligraphyFont', 'bodyFont', 'primaryColor', 'googleClientId',
          'phone1', 'phone2', 'whatsappNumber', 'facebookUrl', 'youtubeUrl', 'telegramUrl',
          'centerBranches', 'developerName', 'developerHandle', 'developerUrl', 'footerBio',
          'footerQuickLinks', 'grades', 'gradeFirstTitleAr', 'gradeFirstTitleEn', 'gradeFirstBadgeAr',
          'gradeFirstDescAr', 'gradeSecondTitleAr', 'gradeSecondTitleEn', 'gradeSecondBadgeAr',
          'gradeSecondDescAr', 'gradeThirdTitleAr', 'gradeThirdTitleEn', 'gradeThirdBadgeAr',
          'gradeThirdDescAr', 'feature1Title', 'feature1Desc', 'feature2Title', 'feature2Desc',
          'feature3Title', 'feature3Desc', 'feature4Title', 'feature4Desc', 'updatedAt'
        ]) &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 150 &&
        data.teacherTitle is string && data.teacherTitle.size() > 0 && data.teacherTitle.size() <= 150 &&
        data.profileImageUrl is string && data.profileImageUrl.size() <= 2000 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
        (!('heroDescription' in data) || (data.heroDescription is string && data.heroDescription.size() <= 2000)) &&
        (!('heroBadge' in data) || (data.heroBadge is string && data.heroBadge.size() <= 200)) &&
        (!('calligraphyFont' in data) || data.calligraphyFont in ['Reem Kufi', 'Aref Ruqaa', 'Amiri', 'Cairo']) &&
        (!('bodyFont' in data) || data.bodyFont in ['Cairo', 'Tajawal', 'Almarai']) &&
        (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() <= 30)) &&
        (!('googleClientId' in data) || (data.googleClientId is string && data.googleClientId.size() <= 300)) &&
        (!('phone1' in data) || (data.phone1 is string && data.phone1.size() <= 50)) &&
        (!('phone2' in data) || (data.phone2 is string && data.phone2.size() <= 50)) &&
        (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
        (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 500)) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500)) &&
        (!('telegramUrl' in data) || (data.telegramUrl is string && data.telegramUrl.size() <= 500)) &&
        (!('centerBranches' in data) || (data.centerBranches is string && data.centerBranches.size() <= 1000)) &&
        (!('developerName' in data) || (data.developerName is string && data.developerName.size() <= 150)) &&
        (!('developerHandle' in data) || (data.developerHandle is string && data.developerHandle.size() <= 150)) &&
        (!('developerUrl' in data) || (data.developerUrl is string && data.developerUrl.size() <= 500)) &&
        (!('footerBio' in data) || (data.footerBio is string && data.footerBio.size() <= 2000)) &&
        (!('footerQuickLinks' in data) || (data.footerQuickLinks is list && data.footerQuickLinks.size() <= 20 && (data.footerQuickLinks.size() == 0 || data.footerQuickLinks[0] is map))) &&
        (!('grades' in data) || (data.grades is list && data.grades.size() > 0 && data.grades.size() <= 20 && data.grades[0] is map)) &&
        (!('gradeFirstTitleAr' in data) || (data.gradeFirstTitleAr is string && data.gradeFirstTitleAr.size() <= 200)) &&
        (!('gradeFirstTitleEn' in data) || (data.gradeFirstTitleEn is string && data.gradeFirstTitleEn.size() <= 200)) &&
        (!('gradeFirstBadgeAr' in data) || (data.gradeFirstBadgeAr is string && data.gradeFirstBadgeAr.size() <= 150)) &&
        (!('gradeFirstDescAr' in data) || (data.gradeFirstDescAr is string && data.gradeFirstDescAr.size() <= 1000)) &&
        (!('gradeSecondTitleAr' in data) || (data.gradeSecondTitleAr is string && data.gradeSecondTitleAr.size() <= 200)) &&
        (!('gradeSecondTitleEn' in data) || (data.gradeSecondTitleEn is string && data.gradeSecondTitleEn.size() <= 200)) &&
        (!('gradeSecondBadgeAr' in data) || (data.gradeSecondBadgeAr is string && data.gradeSecondBadgeAr.size() <= 150)) &&
        (!('gradeSecondDescAr' in data) || (data.gradeSecondDescAr is string && data.gradeSecondDescAr.size() <= 1000)) &&
        (!('gradeThirdTitleAr' in data) || (data.gradeThirdTitleAr is string && data.gradeThirdTitleAr.size() <= 200)) &&
        (!('gradeThirdTitleEn' in data) || (data.gradeThirdTitleEn is string && data.gradeThirdTitleEn.size() <= 200)) &&
        (!('gradeThirdBadgeAr' in data) || (data.gradeThirdBadgeAr is string && data.gradeThirdBadgeAr.size() <= 150)) &&
        (!('gradeThirdDescAr' in data) || (data.gradeThirdDescAr is string && data.gradeThirdDescAr.size() <= 1000)) &&
        (!('feature1Title' in data) || (data.feature1Title is string && data.feature1Title.size() <= 200)) &&
        (!('feature1Desc' in data) || (data.feature1Desc is string && data.feature1Desc.size() <= 1000)) &&
        (!('feature2Title' in data) || (data.feature2Title is string && data.feature2Title.size() <= 200)) &&
        (!('feature2Desc' in data) || (data.feature2Desc is string && data.feature2Desc.size() <= 1000)) &&
        (!('feature3Title' in data) || (data.feature3Title is string && data.feature3Title.size() <= 200)) &&
        (!('feature3Desc' in data) || (data.feature3Desc is string && data.feature3Desc.size() <= 1000)) &&
        (!('feature4Title' in data) || (data.feature4Title is string && data.feature4Title.size() <= 200)) &&
        (!('feature4Desc' in data) || (data.feature4Desc is string && data.feature4Desc.size() <= 1000));
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll(['adminEmails', 'cloudName', 'uploadPreset', 'updatedAt']) &&
        data.keys().hasOnly(['adminEmails', 'cloudName', 'uploadPreset', 'googleClientId', 'updatedAt']) &&
        data.adminEmails is list && data.adminEmails.size() > 0 && data.adminEmails.size() <= 25 && data.adminEmails[0] is string &&
        data.cloudName is string && data.cloudName.size() <= 150 &&
        data.uploadPreset is string && data.uploadPreset.size() <= 150 &&
        (!('googleClientId' in data) || (data.googleClientId is string && data.googleClientId.size() <= 300));
    }

    function isValidLecture(data) {
      return data.keys().hasAll(['id', 'title', 'grade', 'gradeLabel', 'chapter', 'duration', 'videoUrl', 'thumbnailUrl', 'description', 'isFreePreview', 'viewsCount', 'dateAdded', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'grade', 'gradeLabel', 'chapter', 'duration', 'videoUrl', 'thumbnailUrl', 'pdfUrl', 'pdfTitle', 'description', 'isFreePreview', 'viewsCount', 'dateAdded', 'sessionOrder', 'quizId', 'pointsCost', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        isValidGradeId(data.grade) &&
        data.gradeLabel is string && data.gradeLabel.size() > 0 && data.gradeLabel.size() <= 150 &&
        data.chapter is string && data.chapter.size() <= 250 &&
        data.duration is string && data.duration.size() <= 100 &&
        data.videoUrl is string && data.videoUrl.size() <= 2000 &&
        data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000 &&
        (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 2000)) &&
        (!('pdfTitle' in data) || (data.pdfTitle is string && data.pdfTitle.size() <= 300)) &&
        data.description is string && data.description.size() <= 3000 &&
        data.isFreePreview is bool &&
        data.viewsCount is number && data.viewsCount >= 0 &&
        data.dateAdded is string && data.dateAdded.size() <= 50 &&
        (!('sessionOrder' in data) || data.sessionOrder is number) &&
        (!('quizId' in data) || (data.quizId is string && data.quizId.size() <= 128)) &&
        (!('pointsCost' in data) || (data.pointsCost is number && data.pointsCost >= 0 && data.pointsCost <= 100000));
    }

    function isValidAttachment(data) {
      return data.keys().hasAll(['id', 'title', 'grade', 'gradeLabel', 'chapter', 'fileSize', 'fileType', 'downloadUrl', 'dateAdded', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'grade', 'gradeLabel', 'chapter', 'fileSize', 'fileType', 'downloadUrl', 'pageCount', 'dateAdded', 'pointsCost', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        isValidGradeId(data.grade) &&
        data.gradeLabel is string && data.gradeLabel.size() > 0 && data.gradeLabel.size() <= 150 &&
        data.chapter is string && data.chapter.size() <= 250 &&
        data.fileSize is string && data.fileSize.size() <= 50 &&
        data.fileType in ['pdf', 'doc', 'image'] &&
        data.downloadUrl is string && data.downloadUrl.size() > 0 && data.downloadUrl.size() <= 2000 &&
        (!('pageCount' in data) || data.pageCount is number) &&
        data.dateAdded is string && data.dateAdded.size() <= 50 &&
        (!('pointsCost' in data) || (data.pointsCost is number && data.pointsCost >= 0 && data.pointsCost <= 100000));
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['id', 'title', 'grade', 'chapter', 'durationMinutes', 'questions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'grade', 'chapter', 'durationMinutes', 'lectureId', 'questions', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        isValidGradeId(data.grade) &&
        data.chapter is string && data.chapter.size() <= 250 &&
        data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 600 &&
        (!('lectureId' in data) || (data.lectureId is string && data.lectureId.size() <= 128)) &&
        data.questions is list && data.questions.size() <= 200 &&
        (data.questions.size() == 0 || data.questions[0] is map);
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'role', 'phone', 'profileCompleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'uid', 'name', 'email', 'role', 'grade', 'phone', 'parentPhone',
          'governorate', 'avatarUrl', 'score', 'profileCompleted', 'watchedLectureIds',
          'passedQuizIds', 'quizScores', 'joinedAt', 'points', 'unlockedLectureIds',
          'unlockedAttachmentIds', 'claimedRewardIds', 'pointsHistory',
          'lastRedeemedCode', 'lastSpendTargetType', 'lastSpendTargetId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        data.role in ['student', 'teacher'] &&
        (!('grade' in data) || isValidGradeId(data.grade)) &&
        data.phone is string && data.phone.size() <= 50 &&
        (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 50)) &&
        (!('governorate' in data) || (data.governorate is string && data.governorate.size() <= 150)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
        (!('score' in data) || data.score is number) &&
        data.profileCompleted is bool &&
        (!('watchedLectureIds' in data) || (data.watchedLectureIds is list && data.watchedLectureIds.size() <= 500 && (data.watchedLectureIds.size() == 0 || data.watchedLectureIds[0] is string))) &&
        (!('passedQuizIds' in data) || (data.passedQuizIds is list && data.passedQuizIds.size() <= 500 && (data.passedQuizIds.size() == 0 || data.passedQuizIds[0] is string))) &&
        (!('quizScores' in data) || data.quizScores is map) &&
        (!('joinedAt' in data) || (data.joinedAt is string && data.joinedAt.size() <= 50)) &&
        (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 10000000)) &&
        (!('unlockedLectureIds' in data) || (data.unlockedLectureIds is list && data.unlockedLectureIds.size() <= 500 && (data.unlockedLectureIds.size() == 0 || data.unlockedLectureIds[0] is string))) &&
        (!('unlockedAttachmentIds' in data) || (data.unlockedAttachmentIds is list && data.unlockedAttachmentIds.size() <= 500 && (data.unlockedAttachmentIds.size() == 0 || data.unlockedAttachmentIds[0] is string))) &&
        (!('claimedRewardIds' in data) || (data.claimedRewardIds is list && data.claimedRewardIds.size() <= 500 && (data.claimedRewardIds.size() == 0 || data.claimedRewardIds[0] is string))) &&
        (!('pointsHistory' in data) || (data.pointsHistory is list && data.pointsHistory.size() <= 50 && (data.pointsHistory.size() == 0 || data.pointsHistory[0] is map))) &&
        (!('lastRedeemedCode' in data) || (data.lastRedeemedCode is string && data.lastRedeemedCode.size() <= 128)) &&
        (!('lastSpendTargetType' in data) || data.lastSpendTargetType in ['lecture', 'attachment', 'reward']) &&
        (!('lastSpendTargetId' in data) || (data.lastSpendTargetId is string && data.lastSpendTargetId.size() <= 128));
    }

    function isValidRedeemCode(data) {
      return data.keys().hasAll(['id', 'code', 'points', 'maxUses', 'usedCount', 'active', 'createdAtDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'points', 'maxUses', 'usedCount', 'active', 'label', 'createdBy', 'createdAtDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) && data.id.size() <= 64 &&
        isValidId(data.code) && data.code.size() <= 64 &&
        data.points is number && data.points > 0 && data.points <= 100000 &&
        data.maxUses is number && data.maxUses > 0 && data.maxUses <= 100000 &&
        data.usedCount is number && data.usedCount >= 0 && data.usedCount <= data.maxUses &&
        data.active is bool &&
        (!('label' in data) || (data.label is string && data.label.size() <= 150)) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 150)) &&
        data.createdAtDate is string && data.createdAtDate.size() <= 50;
    }

    function isValidCodeRedemption(data, codeId, studentUid) {
      return data.keys().hasAll(['uid', 'studentName', 'code', 'points', 'redeemedAt']) &&
        data.keys().hasOnly(['uid', 'studentName', 'code', 'points', 'redeemedAt']) &&
        data.uid is string && data.uid == studentUid && data.uid.size() <= 128 &&
        data.studentName is string && data.studentName.size() <= 200 &&
        data.code is string && data.code == codeId && data.code.size() <= 64 &&
        data.points is number && data.points > 0 && data.points <= 100000;
    }

    function isValidPointReward(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'pointsCost', 'category', 'grade', 'active', 'dateAdded', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'pointsCost', 'category', 'grade', 'active', 'dateAdded', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.description is string && data.description.size() <= 1500 &&
        data.pointsCost is number && data.pointsCost > 0 && data.pointsCost <= 100000 &&
        data.category in ['perk', 'badge', 'discount', 'material'] &&
        isValidGradeId(data.grade) &&
        data.active is bool &&
        data.dateAdded is string && data.dateAdded.size() <= 50;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'category', 'grade', 'pinned', 'active', 'authorName', 'dateAdded', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'message', 'category', 'grade', 'pinned', 'active', 'authorName', 'dateAdded', 'ctaLabel', 'ctaTab', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.category in ['announcement', 'exam', 'lecture', 'urgent', 'congrats'] &&
        isValidGradeId(data.grade) &&
        data.pinned is bool &&
        data.active is bool &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 150 &&
        data.dateAdded is string && data.dateAdded.size() <= 50 &&
        (!('ctaLabel' in data) || (data.ctaLabel is string && data.ctaLabel.size() <= 80)) &&
        (!('ctaTab' in data) || data.ctaTab in ['lectures', 'quizzes', 'files', 'points', 'study-hub']);
    }

    // ==========================================
    // COLLECTION MATCH BLOCKS
    // ==========================================

    // Public site configuration (readable by all homepage visitors & students in real time)
    match /publicConfig/{docId} {
      allow get: if isValidId(docId) && docId == 'site';
      allow list: if false;
      allow create: if isAdmin() && isValidId(docId) && docId == 'site' && isValidSiteConfig(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(docId) && docId == 'site' && isValidSiteConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Admin configuration & Cloudinary settings
    match /adminConfig/{docId} {
      allow get: if isAdmin() && isValidId(docId) && docId == 'settings';
      allow list: if false;
      allow create: if isAdmin() && isValidId(docId) && docId == 'settings' && isValidAdminConfig(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(docId) && docId == 'settings' && isValidAdminConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Public course catalog: Lectures
    match /lectures/{lectureId} {
      allow get: if isValidId(lectureId);
      allow list: if resource.data.grade != '';
      allow create: if isAdmin() && isValidId(lectureId) && isValidLecture(incoming()) && incoming().id == lectureId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(lectureId) && isValidLecture(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(lectureId);
    }

    // Public course catalog: Attachments / Handouts
    match /attachments/{attachmentId} {
      allow get: if isValidId(attachmentId);
      allow list: if resource.data.grade != '';
      allow create: if isAdmin() && isValidId(attachmentId) && isValidAttachment(incoming()) && incoming().id == attachmentId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(attachmentId) && isValidAttachment(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(attachmentId);
    }

    // Quizzes curriculum bank (readable by grade; writable only by verified admins)
    match /quizzes/{quizId} {
      allow get: if isValidId(quizId);
      allow list: if resource.data.grade != '';
      allow create: if isAdmin() && isValidId(quizId) && isValidQuiz(incoming()) && incoming().id == quizId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(quizId) && isValidQuiz(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(quizId);
    }

    // Admin-defined Points Store & Perks
    match /rewards/{rewardId} {
      allow get: if isValidId(rewardId);
      allow list: if resource.data.grade != '';
      allow create: if isAdmin() && isValidId(rewardId) && isValidPointReward(incoming()) && incoming().id == rewardId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(rewardId) && isValidPointReward(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(rewardId);
    }

    // Platform Announcements & Notifications (readable by grade/all; created/edited/deleted only by verified admins)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if resource.data.grade != '';
      allow create: if isAdmin() && isValidId(notificationId) && isValidNotification(incoming()) && incoming().id == notificationId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(notificationId) && isValidNotification(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // Redeem Codes: Single code lookup allowed for signed-in students; full listing reserved for admins
    match /redeemCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(codeId) && isValidRedeemCode(incoming()) && incoming().id == codeId && incoming().code == codeId && incoming().usedCount == 0 && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(codeId) && isValidRedeemCode(incoming()) && incoming().id == existing().id && incoming().code == existing().code && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (
          isVerifiedUser() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
          existing().active == true &&
          existing().usedCount < existing().maxUses &&
          incoming().usedCount == existing().usedCount + 1 &&
          !exists(/databases/$(database)/documents/redeemCodes/$(codeId)/redemptions/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/redeemCodes/$(codeId)/redemptions/$(request.auth.uid))
        )
      );
      allow delete: if isAdmin() && isValidId(codeId);

      // Subcollection tracking unique student redemptions atomically
      match /redemptions/{studentUid} {
        allow get: if isSignedIn() && isValidId(codeId) && isValidId(studentUid) && (request.auth.uid == studentUid || isAdmin());
        allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if isVerifiedUser() &&
          isValidId(codeId) &&
          isValidId(studentUid) &&
          request.auth.uid == studentUid &&
          isValidCodeRedemption(incoming(), codeId, studentUid) &&
          !exists(/databases/$(database)/documents/redeemCodes/$(codeId)/redemptions/$(studentUid)) &&
          get(/databases/$(database)/documents/redeemCodes/$(codeId)).data.active == true &&
          get(/databases/$(database)/documents/redeemCodes/$(codeId)).data.usedCount < get(/databases/$(database)/documents/redeemCodes/$(codeId)).data.maxUses &&
          incoming().points == get(/databases/$(database)/documents/redeemCodes/$(codeId)).data.points &&
          getAfter(/databases/$(database)/documents/redeemCodes/$(codeId)).data.usedCount == get(/databases/$(database)/documents/redeemCodes/$(codeId)).data.usedCount + 1 &&
          incoming().redeemedAt == request.time;
        allow update, delete: if isAdmin() && isValidId(codeId) && isValidId(studentUid);
      }
    }

    // Private Student Profiles (Strict PII Isolation + Zero-Trust Points Accounting)
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isAdmin() || (isSignedIn() && request.auth.uid == studentId));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(studentId) && isValidStudent(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == studentId &&
          incoming().id == studentId &&
          incoming().uid == request.auth.uid &&
          incoming().role == 'student' &&
          (!('points' in incoming()) || incoming().points == 0) &&
          (!('unlockedLectureIds' in incoming()) || incoming().unlockedLectureIds.size() == 0) &&
          (!('unlockedAttachmentIds' in incoming()) || incoming().unlockedAttachmentIds.size() == 0) &&
          (!('claimedRewardIds' in incoming()) || incoming().claimedRewardIds.size() == 0)
        )
      ) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(studentId) && isValidStudent(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == studentId &&
          incoming().id == existing().id &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          (
            // Action 1: Standard Profile / Progress Update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'email', 'grade', 'phone', 'parentPhone', 'governorate',
              'avatarUrl', 'score', 'profileCompleted', 'watchedLectureIds',
              'passedQuizIds', 'quizScores', 'updatedAt'
            ]) ||
            // Action 2: Redeem Code Atomic Credit
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['points', 'lastRedeemedCode', 'pointsHistory', 'updatedAt']) &&
              incoming().lastRedeemedCode is string &&
              isValidId(incoming().lastRedeemedCode) &&
              !exists(/databases/$(database)/documents/redeemCodes/$(incoming().lastRedeemedCode)/redemptions/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/redeemCodes/$(incoming().lastRedeemedCode)/redemptions/$(request.auth.uid)) &&
              (
                (!('points' in existing()) && incoming().points == get(/databases/$(database)/documents/redeemCodes/$(incoming().lastRedeemedCode)).data.points) ||
                ('points' in existing() && existing().points is number && incoming().points == existing().points + get(/databases/$(database)/documents/redeemCodes/$(incoming().lastRedeemedCode)).data.points)
              )
            ) ||
            // Action 3: Spend Points to Unlock Lecture, Handout, or Reward
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'points', 'unlockedLectureIds', 'unlockedAttachmentIds', 'claimedRewardIds',
                'pointsHistory', 'lastSpendTargetType', 'lastSpendTargetId', 'updatedAt'
              ]) &&
              'points' in existing() &&
              existing().points is number &&
              incoming().points >= 0 &&
              incoming().lastSpendTargetId is string &&
              isValidId(incoming().lastSpendTargetId) &&
              (
                (
                  incoming().lastSpendTargetType == 'lecture' &&
                  get(/databases/$(database)/documents/lectures/$(incoming().lastSpendTargetId)).data.pointsCost is number &&
                  get(/databases/$(database)/documents/lectures/$(incoming().lastSpendTargetId)).data.pointsCost > 0 &&
                  incoming().points == existing().points - get(/databases/$(database)/documents/lectures/$(incoming().lastSpendTargetId)).data.pointsCost
                ) ||
                (
                  incoming().lastSpendTargetType == 'attachment' &&
                  get(/databases/$(database)/documents/attachments/$(incoming().lastSpendTargetId)).data.pointsCost is number &&
                  get(/databases/$(database)/documents/attachments/$(incoming().lastSpendTargetId)).data.pointsCost > 0 &&
                  incoming().points == existing().points - get(/databases/$(database)/documents/attachments/$(incoming().lastSpendTargetId)).data.pointsCost
                ) ||
                (
                  incoming().lastSpendTargetType == 'reward' &&
                  get(/databases/$(database)/documents/rewards/$(incoming().lastSpendTargetId)).data.active == true &&
                  get(/databases/$(database)/documents/rewards/$(incoming().lastSpendTargetId)).data.pointsCost is number &&
                  get(/databases/$(database)/documents/rewards/$(incoming().lastSpendTargetId)).data.pointsCost > 0 &&
                  incoming().points == existing().points - get(/databases/$(database)/documents/rewards/$(incoming().lastSpendTargetId)).data.pointsCost
                )
              )
            )
          )
        )
      ) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(studentId);
    }
  }
}
